# Unity-generated folders (DO NOT commit)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/

# Ignore Visual Studio & Rider generated files
.vs/
*.csproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db

# Unity-generated files (DO NOT commit)
sysinfo.txt
*.stacktrace
*.crash
*.pdb
*.mdb
*.map

# Ignore Unity package cache (but keep `Packages/`)
/Library/PackageCache/

# Keep project-specific settings (DO NOT ignore these)
!ProjectSettings/
!Packages/

# Ignore Unity crash analytics
Assets/StreamingAssets/crashlytics-build.properties

# Ignore builds & exported files
*.apk
*.aab
*.ipa
*.app
*.exe
*.dll
*.so
*.manifest
*.unity3d
*.bundle
*.unitypackage

# Keep Unity meta files
!*.meta

# Unity Debug and Profiling
*.log
*.profiler

# Optional: Remove baked lighting from Git if needed
# Uncomment the next line if lighting should be ignored
# /LightingData.asset
